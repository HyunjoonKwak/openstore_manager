# ===========================================
# Store Manager - Environment Variables
# ===========================================
# Local: cp .env.example .env.local
# Docker: cp .env.example .env

# -------------------------------------------
# Supabase (Required)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -------------------------------------------
# OpenAI API (Optional)
# -------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# -------------------------------------------
# Secrets Encryption (Recommended)
# -------------------------------------------
# AES-256-GCM key for encrypting third-party secrets stored in
# stores.api_config (Naver/OpenAI/Hanjin keys). 64 hex chars (32 bytes).
# Generate with: openssl rand -hex 32
# If unset, secrets are stored in plaintext (legacy behavior).
# Do NOT change or lose this key once secrets are encrypted with it.
SECRETS_ENCRYPTION_KEY=

# -------------------------------------------
# CRON Secret (Required for scheduled sync)
# -------------------------------------------
CRON_SECRET=your-random-cron-secret-here

# Optional: separate key for scheduler administration (falls back to CRON_SECRET)
SCHEDULER_SECRET=

# Optional: additional HTTPS product hosts allowed by the scraper (comma-separated)
SCRAPER_ALLOWED_HOSTS=

# -------------------------------------------
# SMS - CoolSMS (Optional)
# -------------------------------------------
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER_ID=

# -------------------------------------------
# Kakao Alimtalk (Optional)
# -------------------------------------------
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_ID=
KAKAO_ALIMTALK_TEMPLATE_ID=
